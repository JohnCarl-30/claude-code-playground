# Copy to .env.local and fill in (never commit .env.local).

# Default: use the Claude Code login on this computer (run `claude` once to sign in).
# To use an Anthropic API key instead (pay as you go, from https://console.anthropic.com):
# PLAYGROUND_AUTH=api-key
# ANTHROPIC_API_KEY=sk-ant-...

# Amazon Bedrock, Google Vertex AI or Microsoft Foundry: set Claude Code's provider variables,
# e.g. CLAUDE_CODE_USE_BEDROCK=1 plus your AWS credentials and region. See the README.

# Sign-in and progress sync (optional; see "Sync progress across devices" in the README):
# your Supabase project's address and publishable key. Both are safe to expose.
# Never put a secret key (sb_secret_...) here.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
